{
  "Loopr": {
    "ServiceName": "loopr-api"
  },
  "Persistence": {
    "Driver": "memory"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8082",
      "http://127.0.0.1:8082"
    ]
  },
  "DynamoDb": {
    "Region": "us-west-2",
    "MetadataTableName": "loopr-metadata",
    "Endpoint": null
  },
  "S3": {
    "Region": "us-west-2",
    "AudioBucketName": "loopr-audio-local",
    "PresignedUploadExpiresSeconds": 900
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
